{
  "manifest_version": 3,
  "name": "PyDM Catcher",
  "version": "1.4",
  "description": "يلتقط التحميلات والفيديو والصوت ويمررها إلى برنامج PyDM",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PyDM",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "float.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
